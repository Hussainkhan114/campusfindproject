<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F8"
    android:orientation="vertical">

    <!-- Top App Bar with Back Arrow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1E293B"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Item Details"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvDetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Black leather wallet"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetBadges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#E2E8F0"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="FOUND   •   OPEN"
            android:textColor="#1E293B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Key-Value Table matching Reference Screen (e) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ID" android:textColor="#64748B"/>
                <TextView android:id="@+id/tvDetId" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CF-01" android:textColor="#0F172A" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Category" android:textColor="#64748B"/>
                <TextView android:id="@+id/tvDetCategory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wallets &amp; Cards" android:textColor="#0F172A" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Place" android:textColor="#64748B"/>
                <TextView android:id="@+id/tvDetPlace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Main Library" android:textColor="#0F172A" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Date" android:textColor="#64748B"/>
                <TextView android:id="@+id/tvDetDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12-Nov-2026" android:textColor="#0F172A" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Reported by" android:textColor="#64748B"/>
                <TextView android:id="@+id/tvDetReportedBy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Student Affairs" android:textColor="#0F172A" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Location" android:textColor="#64748B"/>
                <TextView android:id="@+id/tvDetLocation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="31.38955, 74.24070" android:textColor="#0F172A" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Map Pin Box matching Reference Screen (e) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#E2E8F0"
            app:cardCornerRadius="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_dialog_map"
                app:tint="#1E293B" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenMaps"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#1E293B"
            android:text="Open in Maps"
            android:textColor="#FFFFFF"
            app:cornerRadius="10dp"
            app:icon="@android:drawable/ic_dialog_map" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarkReturned"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="✓  Mark as Returned"
            app:cornerRadius="10dp" />

    </LinearLayout>
</LinearLayout>